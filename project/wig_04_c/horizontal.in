mesh_file_type = parametric
el_type = p

scaling_factor = 1.0
offset = (/0.0, 0.0, 0.0/)

airfoil_table_correction = T

mesh_symmetry = T
symmetry_point = (/0.0, 0.0, 0.0/)
symmetry_normal = (/0.0, 1.0, 0.0/)

nelem_chord = 20
type_chord = cosineLE

! First section - Root
chord =  1.0           !chord length
twist = -2.0           !chord twist (deg)
airfoil = NACA0012  

! First region - Root > Tip
span  = 1.2             !span of the region
sweep = 0.0             ! sweep angle (deg)
dihed = 0.0             ! dihedral angle (deg)
nelem_span = 6          !number of elements in span region 
type_span = uniform     !distribution of elements in span

! Second section - Tip
chord =  1.0
twist = -2.0
airfoil = NACA0012