mesh_file_type  = parametric
el_type         = v                     ! p : surface panels (Solid Bodies), v: vortex lattice elements (flat surfaces), l: lifting lines (1D Model of a lifting surface)

!offset          =  (/0.0, 0.0, 0.0/)    ! Offset to apply to the loaded points
!scaling_factor  = 1.0                   ! Scaling factor to apply to the loaded points.

airfoil_table_correction = T            ! Airfoil table correction (T/F). Require the viscous correction for v elements by introducing the c81 aerodynamic tables.

mesh_symmetry   = T                     ! Symmetry of the mesh (T/F). Mesh is doubled.
symmetry_point  = (/0.0, 0.0, 0.0/)     ! Point around which to reflect the mesh.
symmetry_normal = (/0.0, 1.0, 0.0/)     ! Direction in which to reflect the mesh.

! mesh_mirror     = F                     ! Mirror of the mesh (T/F). Mesh is not doubled.
! mirror_point    = (/0.0, 0.0, 0.0/)     ! Point around which to mirror the mesh.
! mirror_normal   = (/1.0, 0.0, 0.0/)     ! Direction in which to mirror the mesh.

! twist_linear_interpolation = F          ! Linear interpolation to the twist angle.

! starting_point  =  (/0.0, 0.0, 0.0/)    ! Starting point of the mesh.
! reference_chod_fraction = 0.0           ! Fraction of the chord at which to place the axis which will be rotated of the sweep and dihedral angles and around which airfoils are twisted

mesh_flat       = F                     ! Used only in case of lifting lines (l) elements.

nelem_chord     = 20                    ! Number of elements in chord direction.
! cosineLE for surface panels
! uniform for vortex lattices
type_chord      = uniform               ! Type of subdivision in the chord-wise direction. Options: uniform, cosine, cosineLE, cosineTE, geoseries, geoseries_le, geoseries_te, geoseries_hi

! First Section - Start
chord           = 1.0                   ! Defines a section, by its chord length
twist           = 0.0                   ! Angle of twist, in degrees, of the airfoil section.
airfoil_table   = ./Geometry/airfoils/naca0012.c81 ! Only when 'airfoil_table_correction = T'
airfoil         = NACA0012

! First Reagion
span            = 1.0                   ! Define the span length of the region between two sections.
sweep           = 0.0                   ! Angle of sweep of the region, positive if swept backwards (towards positive x).
dihed           = 0.0                   ! Angle of dihedral of the region, positive if rotated upwards (towards positive z).
nelem_span      = 10                    ! Number of elements in the spanwise direction, in the single region.
type_span       = uniform               ! Type of refinement of the elements in the spanwise direction. Options: uniform, cosine, cosineIB, cosineOB, equalarea,  geoseries, geoseries_ib, geoseries_ob

! First Section - End
chord           = 1.0
twist           = 0.0
airfoil_table   = ./Geometry/airfoils/naca0012.c81
airfoil         = NACA0012
