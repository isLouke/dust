mesh_file_type = parametric
el_type = p

scaling_factor = 1.0
offset = (/0.0, 0.0, 0.0/)

airfoil_table_correction = T

nelem_chord = 40
type_chord = cosineLE

! First section - Root
chord = 1.2           !chord length
twist = 0.0           !chord twist (deg)
airfoil = NACA0012  

! First region - Root > Tip
span  = 1.2             !span of the region
sweep = 0.0             ! sweep angle (deg)
dihed = 0.0             ! dihedral angle (deg)
nelem_span = 10         !number of elements in span region 
type_span = uniform     !distribution of elements in span

! Second section - Tip
chord = 1.0
twist = 0.0
airfoil = NACA0012