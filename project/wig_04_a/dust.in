basename = ./Output/wig_04

tstart  = 0.0 
tend    = 30.0
dt      = 0.1
dt_out  = 0.1

geometry_file = geo_input.h5
reference_file = References.in

! Reference values ---------------------
!P_inf = 101325.0
!a_inf = 340.0
!mu_inf = 0.000018
!rho_inf = 1.2250000 

u_inf = (/30., 0., 0./)

! Model parameters -------------------
particles_box_min = (/ -10, -30, -15 /)
particles_box_max = (/  50,  30,  15/)
fmm = T

! octree parameters--------------------
box_length = 10
n_box = (/6, 6 , 3/)
octree_origin = (/-10 , -30 , -15/)
n_octree_levels = 6
min_octree_part = 5
multipole_degree = 2
vortstretch = T
diffusion = T

! wake parameters  -------------
n_wake_panels = 3
n_wake_particles = 1000000
! wake regularisation
divergence_filtering = T
filter_time_scale = 40
rankine_rad=0.03  
vortex_rad = 0.05 
cutoff_rad = 0.001

! lifting lines solver-----------------
ll_tol = 1.0e-6
ll_damp = 20
ll_reynolds_corrections = F
ll_max_iter = 400